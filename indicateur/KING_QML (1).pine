//@version=6
// ============================================================================
// KING QML — Quasimodo Level (QML-R retournement / QML-C continuation)
// Logique : HHLL (H, L, HH, LL) + QM/MPL (engloutissement, forte dynamique, zone fraîche).
//
// Vendeur : H (épaule gauche) -> L -> HH (> H) -> LL (< L)   | Acheteur : le miroir exact.
// La structure est calculée UNIQUEMENT sur les pivots externes (longueur réglable).
//
// RÈGLES DE VALIDATION (par le CORPS d'une bougie, jamais par une simple mèche) :
//  1) cassure de la ligne QML (niveau de l'épaule gauche) par la tête : au moins une clôture au-delà de la ligne ;
//  2) cassure de structure (LL pour une vente, HH pour un achat) : au moins une clôture au-delà du support (L / H).
//  3) épaule gauche : la ligne QML doit atteindre au moins le milieu du segment support – tête (L et HH pour une vente,
//     H et LL pour un achat), soit une hauteur d'épaule >= 50 % de celle de la tête (réglable, 0 = désactivé).
//  Ces règles sont réglables / désactivables dans « Structure ».
//
// TYPE DE ZONE D'ENTRÉE (paramètres, groupe « Zone d'entrée ») : MPL, Order Block, Zone QML.
//  Pour n'en utiliser qu'UN SEUL : active-le et désactive les deux autres.
//  Si plusieurs sont actifs : priorité MPL, puis OB, puis Zone QML (Midzone = variante du MPL).
//  - MPL        : engloutissement à l'épaule gauche (ou en Midzone), suivi d'un autre marubozu (forte dynamique).
//  - OB         : dernière bougie opposée avant l'impulsion, en premium (vente) / discount (achat) de HH-LL,
//                 fraîche, la plus proche de la ligne QML.
//  - Zone QML   : rectangle entre le niveau de l'épaule gauche (ligne QML) et la tête (HH / LL).
// Ligne d'entrée QML = niveau de l'épaule gauche (H pour une vente, L pour un achat) : « QM ENTRY! » au premier contact.
// QML-R : le QM se forme contre la structure précédente (retournement).
// QML-C : le QM se forme dans le sens de la structure précédente (continuation).
// Tout est calculé à la clôture de la bougie (aucune valeur ne bouge en temps réel).
// ============================================================================
indicator("KING QML (QML-R / QML-C)", shorttitle="KING QML", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ───────────────────────────── Entrées ─────────────────────────────
extLen   = input.int(10, "Longueur des pivots (structure externe)", minval=2, group="Structure")
strictSt = input.bool(true, "Respecter la structure (rejette si ni haussière ni baissière)", group="Structure")

useMpl   = input.bool(false, "Zone MPL (engloutissement à l'épaule gauche)", group="Zone d'entrée", tooltip="Pour n'utiliser qu'UN seul type de zone : active-le et désactive les deux autres. Si plusieurs sont actifs, priorité : MPL, puis OB, puis Zone QML. Si les trois sont désactivés, aucun QML n'est affiché.")
useOb    = input.bool(false, "Order Block (OB)", group="Zone d'entrée", tooltip="Dernière bougie opposée avant l'impulsion, en premium (vente) / discount (achat), la plus proche de la ligne QML.")
useQmlz  = input.bool(true,  "Zone QML (de la ligne QML jusqu'à la tête)", group="Zone d'entrée", tooltip="Rectangle entre le niveau de l'épaule gauche (ligne QML) et le sommet/creux de la tête. Aucune bougie particulière n'est exigée.")
useMid   = input.bool(false, "Autoriser le MPL en Midzone (entrée sur la zone, pas sur la ligne QML)", group="Zone d'entrée")
reqMom   = input.bool(true, "Forte dynamique requise", group="Zone d'entrée")
momBars  = input.int(1, "Bougies max pour la dynamique", minval=1, maxval=3, group="Zone d'entrée")
marRatio = input.float(0.6, "Marubozu : corps / range minimum", minval=0.3, maxval=0.95, step=0.05, group="Zone d'entrée")
marAtr   = input.float(0.5, "Marubozu : corps minimum (x ATR)", minval=0.0, step=0.1, group="Zone d'entrée")
nearAtr  = input.float(0.5, "Tolérance zone / QML (x ATR)", minval=0.0, step=0.1, group="Zone d'entrée")
obBody   = input.bool(false, "OB : corps seulement (sinon bougie entière)", group="Zone d'entrée")
pdFull   = input.bool(true,  "OB : zone entière en premium/discount (sinon seuil moyen à 50 %)", group="Zone d'entrée")
atrLen   = input.int(14, "Période ATR", minval=1, group="Zone d'entrée")

bodyBreak = input.bool(true, "Cassure de la ligne QML validée par le CORPS d'une bougie (clôture au-delà), pas par une mèche", group="Structure")
bodyMin   = input.float(0.0, "Distance minimale de cette clôture au-delà de la ligne (x ATR)", minval=0.0, step=0.1, group="Structure")
bodyStruct    = input.bool(true, "Cassure de structure (LL / HH) validée par le CORPS d'une bougie (clôture au-delà du support), pas par une mèche", group="Structure")
bodyStructMin = input.float(0.0, "Distance minimale de cette clôture au-delà du support (x ATR)", minval=0.0, step=0.1, group="Structure")
shRatio   = input.float(0.5, "Épaule gauche : la ligne QML doit atteindre cette fraction du segment support – tête (0.5 = le milieu, 0 = désactivé)", minval=0.0, maxval=1.0, step=0.05, group="Structure")

maxBars  = input.int(300, "Durée de suivi d'une zone (barres)", minval=10, group="Affichage")
maxQm    = input.int(20, "Nombre max de QML affichés", minval=1, maxval=60, group="Affichage")
showZZ   = input.bool(true, "Zigzag de la structure externe", group="Affichage")
showSw   = input.bool(true, "Étiquettes des swings (L / HH / LL)", group="Affichage")

colZZ    = input.color(#F23645, "Zigzag", group="Couleurs")
colSell  = input.color(#F23645, "Zone vendeuse", group="Couleurs")
colBuy   = input.color(#089981, "Zone acheteuse", group="Couleurs")
colR     = input.color(#FF9800, "QML-R (retournement)", group="Couleurs")
colC     = input.color(#00BCD4, "QML-C (continuation)", group="Couleurs")

// ───────────────────────────── Données ─────────────────────────────
// Toutes les bougies sont stockées dans des tableaux : index du tableau == bar_index.
var array<float> aO = array.new<float>()
var array<float> aH = array.new<float>()
var array<float> aL = array.new<float>()
var array<float> aC = array.new<float>()
var array<float> aA = array.new<float>()

// Swings externes (zigzag alterné) : type (+1 haut / -1 bas), prix, barre, ligne
var array<int>   swT    = array.new<int>()
var array<float> swP    = array.new<float>()
var array<int>   swB    = array.new<int>()
var array<line>  swLine = array.new<line>()

type Qm
    int dir = 0          // +1 vendeur, -1 acheteur
    int typ = 0          // 1 = QML-R, 2 = QML-C
    int kind = 0         // 1 = MPL, 2 = OB, 3 = MPL Midzone, 4 = Zone QML
    float tt = na        // zone (espace transformé : vendeur = prix, acheteur = -prix)
    float tb = na
    float ent = na       // niveau d'entrée QML (espace transformé)
    int hb = 0
    int lb = 0
    int hhb = 0
    int llb = 0
    int left = 0
    int det = 0
    int touch = -1
    int inv = -1
    int endBar = 0
    bool done = false
    float pH = na        // prix réels des 4 swings (épaule gauche, support, tête, cassure)
    float pL = na
    float pHH = na
    float pLL = na
    box bx = na
    line mid = na
    line qml = na
    label lType = na
    label lEntry = na
    label lB = na
    label lC = na
    label lE = na

var array<Qm> qms = array.new<Qm>()

// ─────────────── Accesseurs (d = +1 vendeur, -1 acheteur : miroir des prix) ───────────────
xH(int d, int i) =>
    d == 1 ? array.get(aH, i) : -array.get(aL, i)

xL(int d, int i) =>
    d == 1 ? array.get(aL, i) : -array.get(aH, i)

xO(int d, int i) =>
    d * array.get(aO, i)

xC(int d, int i) =>
    d * array.get(aC, i)

swPv(int d, int i) =>
    d * array.get(swP, i)

realTop(int d, float tt, float tb) =>
    d == 1 ? tt : -tb

realBot(int d, float tt, float tb) =>
    d == 1 ? tb : -tt

realEntry(int d, float tb) =>
    d * tb

// ─────────────── Bougies : marubozu, engloutissement, dynamique ───────────────
bearMaru(int d, int i) =>
    float rng = xH(d, i) - xL(d, i)
    float body = xO(d, i) - xC(d, i)
    body > 0 and rng > 0 and body / rng >= marRatio and body >= marAtr * array.get(aA, i)

engulfAt(int d, int j) =>
    bool r = false
    if j >= 1
        if bearMaru(d, j)
            r := xC(d, j) < xL(d, j - 1) and (xH(d, j) - xL(d, j)) > (xH(d, j - 1) - xL(d, j - 1))
    r

momentumAt(int d, int j) =>
    bool ok = not reqMom
    if reqMom
        int lastBar = array.size(aO) - 1
        for m = 1 to momBars
            if j + m <= lastBar
                if bearMaru(d, j + m)
                    ok := true
    ok

// ─────────────── Recherche de la zone d'entrée ───────────────
// Retour : [type (0 aucune, 1 MPL, 2 OB, 3 MPL Midzone), haut, bas, barre gauche]

zoneLsMpl(int d, int hb, int lb, float pH, float pHH, float pLL) =>
    int kind = 0
    float tt = na
    float tb = na
    int zl = -1
    int j0 = hb > 1 ? hb : 1
    for j = j0 to lb
        if kind == 0
            if engulfAt(d, j) and momentumAt(d, j)
                float t1 = math.max(xH(d, j - 1), xH(d, j))
                float b1 = xL(d, j - 1)
                if t1 >= pH - nearAtr * array.get(aA, j) and t1 <= pHH and b1 >= pLL
                    kind := 1
                    tt := t1
                    tb := b1
                    zl := j - 1
    [kind, tt, tb, zl]

// Order block de la jambe du QM : dernière bougie haussière (vendeur) avant une impulsion baissière,
// en premium (vendeur) / discount (acheteur) de l'intervalle HH-LL, fraîche, et la plus proche de la ligne QML.
zoneOb(int d, int lb, int hhb, int llb, float pH, float pHH, float pLL) =>
    int kind = 0
    float tt = na
    float tb = na
    int zl = -1
    float bd = na
    int bs = 0
    float eq = (pHH + pLL) / 2
    array<int> seen = array.new<int>()
    int j0 = hhb > 1 ? hhb : 1
    for j = j0 to llb
        if bearMaru(d, j) and xC(d, j) < xL(d, j - 1) and momentumAt(d, j)
            int io = -1
            for k = j - 1 to lb
                if io < 0 and xC(d, k) > xO(d, k)
                    io := k
            if io >= 0 and not array.includes(seen, io)
                if xC(d, j) < xL(d, io)
                    array.push(seen, io)
                    float t1 = obBody ? xC(d, io) : xH(d, io)
                    float b1 = obBody ? xO(d, io) : xL(d, io)
                    float md = (t1 + b1) / 2
                    bool prem = pdFull ? b1 >= eq : md >= eq
                    if prem and t1 <= pHH and b1 >= pLL
                        int st = j + 1 + (reqMom ? momBars : 0)
                        bool touched = false
                        if st <= llb
                            for k2 = st to llb
                                if xH(d, k2) >= b1
                                    touched := true
                        if not touched
                            float dist = (b1 <= pH and pH <= t1) ? 0.0 : math.min(math.abs(b1 - pH), math.abs(t1 - pH))
                            int sd = md >= pH ? 0 : 1
                            bool better = kind == 0 or dist < bd or (dist == bd and (sd < bs or (sd == bs and io < zl)))
                            if better
                                kind := 2
                                tt := t1
                                tb := b1
                                zl := io
                                bd := dist
                                bs := sd
    [kind, tt, tb, zl]

zoneMid(int d, int hhb, int llb, float pHH, float pLL) =>
    int kind = 0
    float tt = na
    float tb = na
    int zl = -1
    for j = hhb + 1 to llb
        if kind == 0
            if engulfAt(d, j) and momentumAt(d, j)
                float t1 = math.max(xH(d, j - 1), xH(d, j))
                float b1 = xL(d, j - 1)
                if t1 <= pHH and b1 >= pLL
                    int st = j + 1 + (reqMom ? momBars : 0)
                    bool touched = false
                    if st <= llb
                        for k = st to llb
                            if xH(d, k) >= b1
                                touched := true
                    if not touched
                        kind := 3
                        tt := t1
                        tb := b1
                        zl := j - 1
    [kind, tt, tb, zl]

// ─────────────── Suivi d'une zone (entrée, invalidation) ───────────────
method upd(Qm this, int k) =>
    if not this.done
        this.endBar := k
        if k - this.det > maxBars
            this.done := true
        else
            if this.touch < 0 and xH(this.dir, k) >= this.ent
                this.touch := k
            if xC(this.dir, k) > math.max(this.tt, this.ent)
                this.inv := k
                this.done := true

mkLbl(int x, float y, string t, bool isHigh, color bg, color tc) =>
    label.new(x, y, t, xloc=xloc.bar_index, yloc=yloc.price, color=bg, style=(isHigh ? label.style_label_down : label.style_label_up), textcolor=tc, size=size.small)

method refresh(Qm this) =>
    box.set_right(this.bx, this.endBar)
    line.set_x2(this.mid, this.endBar)
    line.set_x2(this.qml, this.touch >= 0 ? this.touch : this.endBar)
    if this.touch >= 0 and na(this.lEntry)
        this.lEntry := mkLbl(this.touch, realEntry(this.dir, this.ent), "QM ENTRY!", this.dir == 1, color.black, color.white)
    if this.inv >= 0
        box.set_bgcolor(this.bx, color.new(color.gray, 88))
        box.set_border_color(this.bx, color.gray)

method destroy(Qm this) =>
    if not na(this.bx)
        box.delete(this.bx)
    if not na(this.mid)
        line.delete(this.mid)
    if not na(this.qml)
        line.delete(this.qml)
    if not na(this.lType)
        label.delete(this.lType)
    if not na(this.lEntry)
        label.delete(this.lEntry)
    if not na(this.lB)
        label.delete(this.lB)
    if not na(this.lC)
        label.delete(this.lC)
    if not na(this.lE)
        label.delete(this.lE)

// ─────────────── Création d'un QML ───────────────
makeQm(int d, int typ, int kind, float tt, float tb, float ent, int zl, int hb, int lb, int hhb, int llb, float pH, float pL, float pHH, float pLL, int now) =>
    Qm q = Qm.new()
    q.dir := d
    q.typ := typ
    q.kind := kind
    q.tt := tt
    q.tb := tb
    q.ent := ent
    q.left := zl
    q.hb := hb
    q.lb := lb
    q.hhb := hhb
    q.llb := llb
    q.pH := pH
    q.pL := pL
    q.pHH := pHH
    q.pLL := pLL
    q.det := now
    q.endBar := llb

    color zc = d == 1 ? colSell : colBuy
    color tc = typ == 1 ? colR : colC
    float yTop = realTop(d, tt, tb)
    float yBot = realBot(d, tt, tb)
    float yMid = (yTop + yBot) / 2
    float yEnt = realEntry(d, ent)
    q.bx := box.new(left=zl, top=yTop, right=now, bottom=yBot, xloc=xloc.bar_index, border_color=tc, border_width=1, bgcolor=color.new(zc, 82))
    q.mid := line.new(zl, yMid, now, yMid, xloc=xloc.bar_index, color=color.purple, style=line.style_dashed, width=1)
    int xs = kind == 3 ? zl : hb
    q.qml := line.new(xs, yEnt, now, yEnt, xloc=xloc.bar_index, color=tc, style=(kind == 3 ? line.style_dotted : line.style_solid), width=2)

    string tag = (typ == 1 ? "QML-R" : "QML-C") + (d == 1 ? " ▼ " : " ▲ ") + (kind == 1 ? "MPL" : kind == 2 ? "OB" : kind == 3 ? "MID" : "ZONE QML")
    q.lType := mkLbl(hb, pH, tag, d == 1, tc, color.black)
    if showSw
        q.lB := mkLbl(lb, pL, d == 1 ? "L" : "H", d == -1, color.new(color.gray, 20), color.white)
        q.lC := mkLbl(hhb, pHH, d == 1 ? "HH" : "LL", d == 1, color.new(color.gray, 20), color.white)
        q.lE := mkLbl(llb, pLL, d == 1 ? "LL" : "HH", d == -1, color.new(color.gray, 20), color.white)
    q

// ─────────────── Détection d'un QM sur les 4 derniers swings ───────────────
detectQm(int d, int now) =>
    int n = array.size(swT)
    if n >= 6
        int e = n - 1
        int c = n - 2
        int b = n - 3
        int a = n - 4
        if array.get(swT, e) == -d
            int hb = array.get(swB, a)
            bool isReg = false
            for q in qms
                if q.dir == d and q.hb == hb
                    isReg := true
            float pa = swPv(d, a)
            float pb = swPv(d, b)
            float pc = swPv(d, c)
            float pe = swPv(d, e)
            float pa2 = swPv(d, n - 6)
            float pb2 = swPv(d, n - 5)
            bool shOk = shRatio <= 0.0 or (pa - pb) >= shRatio * (pc - pb)
            bool bodyOk = not bodyBreak
            if bodyBreak
                int lbBody = array.get(swB, b)
                int hhbBody = array.get(swB, c)
                for kb = lbBody + 1 to hhbBody
                    if xC(d, kb) > pa + bodyMin * array.get(aA, kb)
                        bodyOk := true
            bool structOk = not bodyStruct
            if bodyStruct
                int hhbStruct = array.get(swB, c)
                for ks = hhbStruct + 1 to now
                    if xC(d, ks) < pb - bodyStructMin * array.get(aA, ks)
                        structOk := true
            if not isReg and pc > pa and pe < pb and shOk and bodyOk and structOk
                int typ = 0
                if pa > pa2 and pb > pb2
                    typ := 1
                else if pa < pa2 and pb < pb2
                    typ := 2
                else if not strictSt
                    typ := pa > pa2 ? 1 : 2
                if typ > 0
                    int lb = array.get(swB, b)
                    int hhb = array.get(swB, c)
                    int llb = array.get(swB, e)
                    int kind = 0
                    float tt = na
                    float tb = na
                    int zl = -1
                    if useMpl
                        [k1, t1, b1, l1] = zoneLsMpl(d, hb, lb, pa, pc, pe)
                        if k1 > 0
                            kind := k1
                            tt := t1
                            tb := b1
                            zl := l1
                    if kind == 0 and useOb
                        [k2, t2, b2, l2] = zoneOb(d, lb, hhb, llb, pa, pc, pe)
                        if k2 > 0
                            kind := k2
                            tt := t2
                            tb := b2
                            zl := l2
                    if kind == 0 and useMid and useMpl
                        [k3, t3, b3, l3] = zoneMid(d, hhb, llb, pc, pe)
                        if k3 > 0
                            kind := k3
                            tt := t3
                            tb := b3
                            zl := l3
                    if kind == 0 and useQmlz
                        kind := 4
                        tt := pc
                        tb := pa
                        zl := hhb
                    if kind > 0
                        float ent = kind == 3 ? tb : pa
                        Qm q = makeQm(d, typ, kind, tt, tb, ent, zl, hb, lb, hhb, llb, array.get(swP, a), array.get(swP, b), array.get(swP, c), array.get(swP, e), now)
                        array.push(qms, q)
                        if now >= llb + 1
                            for k = llb + 1 to now
                                q.upd(k)
                        q.refresh()
                        while array.size(qms) > maxQm
                            Qm old = array.shift(qms)
                            old.destroy()

// ─────────────── Swings externes (zigzag alterné) ───────────────
pushSwing(int t, float price, int bar) =>
    int sz = array.size(swT)
    line ln = na
    if showZZ and sz > 0
        ln := line.new(array.get(swB, sz - 1), array.get(swP, sz - 1), bar, price, xloc=xloc.bar_index, color=colZZ, width=1)
    array.push(swT, t)
    array.push(swP, price)
    array.push(swB, bar)
    array.push(swLine, ln)
    if array.size(swT) > 60
        array.shift(swT)
        array.shift(swP)
        array.shift(swB)
        array.shift(swLine)

addSwing(int t, float price, int bar) =>
    bool act = false
    int sz = array.size(swT)
    if sz == 0
        pushSwing(t, price, bar)
        act := true
    else
        int lt = array.get(swT, sz - 1)
        float lp = array.get(swP, sz - 1)
        if lt == t
            if (t == 1 and price > lp) or (t == -1 and price < lp)
                array.set(swP, sz - 1, price)
                array.set(swB, sz - 1, bar)
                line ln = array.get(swLine, sz - 1)
                if not na(ln)
                    line.set_xy2(ln, bar, price)
                act := true
        else
            pushSwing(t, price, bar)
            act := true
    act

// Pivot haut : strictement plus haut que les `ext` barres à gauche, >= aux `ext` barres à droite.
isPivotHigh(int p, int ext) =>
    float v = array.get(aH, p)
    bool ok = true
    for k = p - ext to p - 1
        if array.get(aH, k) >= v
            ok := false
    for k = p + 1 to p + ext
        if array.get(aH, k) > v
            ok := false
    ok

isPivotLow(int p, int ext) =>
    float v = array.get(aL, p)
    bool ok = true
    for k = p - ext to p - 1
        if array.get(aL, k) <= v
            ok := false
    for k = p + 1 to p + ext
        if array.get(aL, k) < v
            ok := false
    ok

// ───────────────────────────── Boucle principale ─────────────────────────────
float atrV = ta.atr(atrLen)
bool newSell = false
bool newBuy = false

if barstate.isconfirmed
    array.push(aO, open)
    array.push(aH, high)
    array.push(aL, low)
    array.push(aC, close)
    array.push(aA, nz(atrV))
    int n = array.size(aO) - 1

    // 1) suivi des zones existantes
    for q in qms
        if not q.done
            q.upd(n)
            q.refresh()

    // 2) pivots externes confirmés `extLen` barres plus tard
    int p = n - extLen
    if p >= extLen
        bool ph = isPivotHigh(p, extLen)
        bool pl = isPivotLow(p, extLen)
        int t = 0
        if ph and pl
            int szs = array.size(swT)
            t := (szs > 0 and array.get(swT, szs - 1) == 1) ? -1 : 1
        else if ph
            t := 1
        else if pl
            t := -1
        if t != 0
            float price = t == 1 ? array.get(aH, p) : array.get(aL, p)
            addSwing(t, price, p)
    int szLast = array.size(swT)
    if szLast > 0
        detectQm(-array.get(swT, szLast - 1), n)

    // 3) signaux d'entrée de cette barre
    for q in qms
        if q.touch == n
            if q.dir == 1
                newSell := true
            else
                newBuy := true

alertcondition(newSell, "QM ENTRY vendeur", "KING QML : entrée vendeuse sur {{ticker}} ({{interval}})")
alertcondition(newBuy, "QM ENTRY acheteur", "KING QML : entrée acheteuse sur {{ticker}} ({{interval}})")
